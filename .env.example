NODE_ENV=development
PORT=4000
MONGODB_URI=MONGODB_URI=
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-0000
JWT_REFRESH_SECRET=change-me-too-change-me-too-change-me-too-1111
# Comma-separated browser origins allowed to call the API directly (CORS + CSRF origin check)
CLIENT_ORIGINS=http://localhost:3000
# Number of reverse proxies in front of the API (Render = 1). Used for correct client IPs in rate limits.
TRUST_PROXY=1
# Used only by `npm run seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeThisAdminPassword
